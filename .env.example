APP_URL=http://localhost:4321

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clé de signature des sessions : openssl rand -base64 32
AUTH_SECRET=
